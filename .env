# 推荐：使用通用 OpenAI-compatible 配置接入 DeepSeek

LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.6-flash
LLM_MAX_TOKENS=128000

# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-v4-pro
# LLM_MAX_TOKENS=128000

# 也支持以下别名；二选一即可，不要把真实密钥提交到仓库
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 仍兼容 OpenAI 配置
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o

TAVILY_API_KEY="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"

# 命令行参数 --max-iterations 1
# 这次运行外层最多只执行 1 轮 planner/executor/review 循环

# 默认外层循环上限 如果不传--max-iterations
# 程序默认最多跑 MAX_PLAN_ITERATIONS
MAX_PLAN_ITERATIONS=5

# 内层 Search Agent 的最大搜索轮数
MAX_SEARCH_ROUNDS=5

# 这是每一轮 search round 里生成几条搜索 query
QUERIES_PER_ROUND=3

# 这是工具调用的最大并发数
MAX_PARALLEL_TOOLS=5

EVIDENCE_EXTRACTION_MODE=llm  # llm / auto
# 控制 evidence 抽取这一层最多等多久
EVIDENCE_EXTRACTION_TIMEOUT_SECONDS=60
# 控制底层 API 请求最多等多久
LLM_REQUEST_TIMEOUT_SECONDS=90