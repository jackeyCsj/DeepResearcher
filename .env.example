# 推荐：使用通用 OpenAI-compatible 配置接入 DeepSeek
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_MAX_TOKENS=128000
LLM_DEFAULT_OUTPUT_TOKENS=2048
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=0
EVIDENCE_EXTRACTION_MODE=auto
EVIDENCE_EXTRACTION_TIMEOUT_SECONDS=12

# 也支持以下别名；二选一即可，不要把真实密钥提交到仓库
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 阿里云百炼 / DashScope OpenAI 兼容接口
# DASHSCOPE_API_KEY=sk-...
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-max

# 仍兼容 OpenAI 配置
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o

TAVILY_API_KEY=tvly-...

MAX_PLAN_ITERATIONS=15
MAX_SEARCH_ROUNDS=10
QUERIES_PER_ROUND=3
MAX_PARALLEL_TOOLS=5
